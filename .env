# Blockchain Audit Configuration
# Set to 'false' when you want to connect to a live Ethereum Sepolia network
USE_MOCK_BLOCKCHAIN=true

# Sepolia RPC URL (Infura, Alchemy, or public endpoint)
SEPOLIA_RPC_URL=https://rpc.sepolia.org

# Deployed TransactionAuditor contract address
CONTRACT_ADDRESS=0x89205A3A3b2A55388eC7311149954C5a0d3f8EB2

# Auditor wallet private key (Only required if USE_MOCK_BLOCKCHAIN=false)
# NEVER commit your real private key with mainnet funds!
PRIVATE_KEY=

# Flask Configuration
FLASK_ENV=development
PORT=5000
